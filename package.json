{
  "name": "fbro",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "spy": "FBRO_SPY=1 tauri dev",
    "e2e:smoke": "npm run e2e:smoke:local",
    "e2e:smoke:local": "FBRO_E2E_LOCAL=1 node tests/e2e/smoke/index.mjs",
    "e2e:smoke:local_debug": "tauri build --debug --no-bundle && FBRO_APP_BINARY=src-tauri/target/debug/fbro FBRO_E2E_COMPOSE_FILES=docker-compose.e2e.host.yml:docker-compose.e2e.debug.yml FBRO_E2E_LOCAL=1 node tests/e2e/smoke/index.mjs",
    "e2e:smoke:runner": "node tests/e2e/smoke/index.mjs",
    "test:build-info": "node --test tests/build-info.test.mjs",
    "test:notifications": "node --test --test-isolation=none tests/notifications.test.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tauri-apps/api": "^2.12.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "heic-to": "1.6.5",
    "heic2any": "0.0.4",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "5.5.207",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-tooltip": "^5.30.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "webdriverio": "^10.0.2",
    "ws": "^8.22.0"
  }
}
