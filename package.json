{
  "name": "fbro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "spy": "FBRO_SPY=1 tauri dev",
    "e2e:smoke": "npm run e2e:smoke:local",
    "e2e:smoke:local": "FBRO_E2E_LOCAL=1 node tests/e2e/smoke/index.mjs",
    "e2e:smoke:local_debug": "tauri build --debug --no-bundle && FBRO_APP_BINARY=src-tauri/target/debug/fbro FBRO_E2E_COMPOSE_FILES=docker-compose.e2e.host.yml:docker-compose.e2e.debug.yml FBRO_E2E_LOCAL=1 node tests/e2e/smoke/index.mjs",
    "e2e:smoke:runner": "node tests/e2e/smoke/index.mjs",
    "test:build-info": "node --test tests/build-info.test.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tabler/icons-react": "^3.41.1",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "mermaid": "^11.14.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-tooltip": "^5.30.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "webdriverio": "^9.20.0",
    "ws": "^8.18.3"
  }
}
